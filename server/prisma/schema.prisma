generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────

enum TeamRole {
  OWNER
  ADMIN
  DEVELOPER
  REVIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  INVITED
  DECLINED
}

enum OAuthProvider {
  GITHUB
}

enum OAuthFlowPurpose {
  SIGN_IN
  LINK_ACCOUNT
}

enum GitHubAccountType {
  USER
  ORGANIZATION
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  VALIDATING
  IN_REVIEW
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  BLOCKED
  PUBLISHING
  PUBLISHED
  CANCELLED
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  COMMENTED
}

enum PullRequestState {
  OPEN
  CLOSED
  MERGED
}

enum ValidationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─── Identity ────────────────────────────────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(320)
  name            String?   @db.VarChar(120)
  passwordHash    String?   @db.VarChar(255)
  emailVerifiedAt DateTime? @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  oauthAccounts   OAuthAccount[]
  githubCredential GitHubOAuthCredential?
  teamMemberships TeamMember[]
  refreshTokens   RefreshToken[]
  sentTeamInvitations TeamInvitation[]

  submissions              Submission[]              @relation("SubmissionAuthor")
  reviews                  Review[]                  @relation("ReviewReviewer")
  reviewComments           ReviewComment[]           @relation("ReviewCommentAuthor")
  auditEvents              AuditEvent[]              @relation("AuditActor")
  githubOAuthFlows         OAuthFlowState[]
  githubInstallationStates GitHubInstallationState[]
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @db.VarChar(64)
  username          String?       @db.VarChar(255)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model GitHubOAuthCredential {
  userId     String   @id @db.Uuid
  ciphertext String   @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthFlowState {
  state     String           @id @db.Char(64)
  purpose   OAuthFlowPurpose
  userId    String?          @db.Uuid
  expiresAt DateTime         @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, purpose])
}

// ─── Teams ───────────────────────────────────────────

model Team {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  slug String @unique @db.VarChar(100)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  members                  TeamMember[]
  invitations              TeamInvitation[]
  installations            GitHubInstallation[]
  repositories             Repository[]
  settings                 TeamSettings?
  auditEvents              AuditEvent[]
  githubInstallationStates GitHubInstallationState[]
}

model TeamMember {
  id     String           @id @default(uuid()) @db.Uuid
  teamId String           @db.Uuid
  userId String           @db.Uuid
  role   TeamRole         @default(DEVELOPER)
  status MembershipStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId, status])
  @@index([teamId, role])
}

model TeamInvitation {
  id          String   @id @default(uuid()) @db.Uuid
  teamId      String   @db.Uuid
  email       String   @db.VarChar(320)
  role        TeamRole @default(DEVELOPER)
  invitedById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  expiresAt   DateTime @db.Timestamptz(6)
  respondedAt DateTime? @db.Timestamptz(6)
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy   User     @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  @@unique([teamId, email])
  @@index([email, expiresAt])
}

model TeamSettings {
  teamId String @id @db.Uuid
  config Json

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// ─── GitHub Integration ──────────────────────────────

model GitHubInstallation {
  id                  String            @id @default(uuid()) @db.Uuid
  installationId      BigInt            @unique
  accountId           BigInt
  accountLogin        String            @db.VarChar(255)
  accountType         GitHubAccountType
  teamId              String            @db.Uuid
  accountUrl          String?           @db.Text
  permissions         Json?
  repositorySelection String?           @db.VarChar(32)
  suspendedAt         DateTime?         @db.Timestamptz(6)
  removedAt           DateTime?         @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  team         Team         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  repositories Repository[]

  @@index([teamId])
}

model GitHubInstallationState {
  state     String   @id @db.Char(64)
  userId    String   @db.Uuid
  teamId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, teamId])
}

model GitHubWebhookDelivery {
  deliveryId  String   @id @db.VarChar(100)
  event       String   @db.VarChar(100)
  processedAt DateTime @default(now()) @db.Timestamptz(6)
}

model Repository {
  id             String @id @default(uuid()) @db.Uuid
  githubRepoId   BigInt @unique
  teamId         String @db.Uuid
  installationId String @db.Uuid

  name          String  @db.VarChar(255)
  fullName      String  @db.VarChar(255)
  ownerLogin    String  @db.VarChar(255)
  defaultBranch String  @db.VarChar(255)
  htmlUrl       String  @db.Text
  isPrivate     Boolean @default(true)
  isArchived    Boolean @default(false)

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  team         Team               @relation(fields: [teamId], references: [id], onDelete: Restrict)
  installation GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Restrict)

  submissions Submission[]
  settings    RepositorySettings?

  @@unique([teamId, fullName])
  @@index([teamId])
  @@index([installationId])
}

model RepositorySettings {
  repositoryId String @id @db.Uuid
  config       Json

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

// ─── Code Governance ─────────────────────────────────

model Submission {
  id            String @id @default(uuid()) @db.Uuid
  repositoryId  String @db.Uuid
  submittedById String @db.Uuid

  title       String  @db.VarChar(200)
  description String? @db.Text

  sourceBranch String @db.Text
  targetBranch String @db.Text

  baseCommitSha   String  @db.VarChar(64)
  headCommitSha   String  @db.VarChar(64)
  sourceCommitSha String? @db.VarChar(64)
  patchStorageKey String? @db.Text
  idempotencyKey  String? @db.VarChar(128)
  idempotencyHash String? @db.Char(64)

  status SubmissionStatus @default(DRAFT)

  submittedAt DateTime? @db.Timestamptz(6)
  publishedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  repository  Repository @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  submittedBy User       @relation("SubmissionAuthor", fields: [submittedById], references: [id], onDelete: Restrict)

  reviews        Review[]
  pullRequest    PullRequest?
  validationRuns ValidationRun[]

  @@unique([submittedById, idempotencyKey])
  @@index([repositoryId, status, createdAt])
  @@index([submittedById, createdAt])
  @@index([status, createdAt])
}

model Review {
  id                String         @id @default(uuid()) @db.Uuid
  submissionId      String         @db.Uuid
  reviewerId        String         @db.Uuid
  decision          ReviewDecision
  reviewedCommitSha String         @db.VarChar(64)
  body              String?        @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  reviewer   User       @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  comments ReviewComment[]

  @@index([submissionId, createdAt])
  @@index([reviewerId, createdAt])
}

model ReviewComment {
  id       String  @id @default(uuid()) @db.Uuid
  reviewId String  @db.Uuid
  authorId String  @db.Uuid
  filePath String? @db.Text
  line     Int?
  body     String  @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  author User   @relation("ReviewCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([reviewId])
  @@index([authorId])
}

// ─── Publishing ─────────────────────────────────────

model PullRequest {
  id           String           @id @default(uuid()) @db.Uuid
  submissionId String           @unique @db.Uuid
  githubPrId   BigInt           @unique
  number       Int
  url          String           @db.Text
  state        PullRequestState @default(OPEN)
  isDraft      Boolean          @default(false)

  headBranch    String  @db.Text
  baseBranch    String  @db.Text
  headCommitSha String? @db.VarChar(64)

  mergedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@index([state])
}

// ─── Audit ───────────────────────────────────────────

model AuditEvent {
  id      String  @id @default(uuid()) @db.Uuid
  teamId  String  @db.Uuid
  actorId String? @db.Uuid

  action     String @db.VarChar(100)
  entityType String @db.VarChar(80)
  entityId   String @db.VarChar(100)

  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  tokenHash String @unique @db.Char(64)
  familyId  String @default(uuid()) @db.Uuid

  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
}

model ValidationRun {
  id           String           @id @default(uuid()) @db.Uuid
  submissionId String           @db.Uuid
  commitSha    String           @db.VarChar(64)
  status       ValidationStatus @default(QUEUED)

  startedAt   DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)

  reportStorageKey String? @db.Text
  errorCode        String? @db.VarChar(100)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  submission Submission          @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  findings   ValidationFinding[]

  @@index([submissionId, createdAt])
  @@index([status, createdAt])
  @@index([commitSha])
}

model ValidationFinding {
  id              String @id @default(uuid()) @db.Uuid
  validationRunId String @db.Uuid

  tool        String          @db.VarChar(50)
  ruleId      String?         @db.VarChar(255)
  severity    FindingSeverity
  title       String          @db.VarChar(500)
  description String?         @db.Text
  filePath    String?         @db.Text
  line        Int?
  fingerprint String?         @db.VarChar(64)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  validationRun ValidationRun @relation(fields: [validationRunId], references: [id], onDelete: Cascade)

  @@index([validationRunId, severity])
  @@index([fingerprint])
}
