    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
