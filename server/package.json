{
  "name": "@haki/server",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --config ./vitest.config.ts --no-file-parallelism --maxWorkers=1",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "worker:validation": "tsx src/jobs/validation.worker.ts",
    "queue:test": "tsx src/jobs/validation.producer.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "@haki/schemas": "^0.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
