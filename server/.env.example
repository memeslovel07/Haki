PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Application/database configuration
DATABASE_URL=postgresql://user:password@localhost:5432/haki
DIRECT_URL=postgresql://user:password@localhost:5432/haki
JWT_ACCESS_SECRET=generate-at-least-32-random-bytes-and-base64url-encode
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# GitHub OAuth App used for HAKI sign-in
GITHUB_OAUTH_CLIENT_ID=replace-me
GITHUB_OAUTH_CLIENT_SECRET=replace-me
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# GitHub App used for repository access and validation
GITHUB_APP_ID=replace-me
GITHUB_APP_SLUG=your-haki-app-slug
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
GITHUB_APP_SETUP_URL=http://localhost:5000/api/v1/github/setup
GITHUB_APP_WEBHOOK_URL=http://localhost:5000/api/v1/github/webhook
GITHUB_APP_WEBHOOK_SECRET=replace-me
GITHUB_APP_STATE_SECRET=generate-a-separate-random-secret
