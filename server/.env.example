# PostgreSQL connection strings (use the pooled URL for DATABASE_URL and direct URL for migrations).
DATABASE_URL=postgresql://user:password@localhost:5432/haki
DIRECT_URL=postgresql://user:password@localhost:5432/haki

# Generate a random value with at least 32 bytes.
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
FRONTEND_ORIGIN=http://localhost:5173
PORT=5000
NODE_ENV=development

# Gemini powered, authenticated HAKI Assistant.
GEMINI_API_KEY=replace_with_your_gemini_api_key
# Optional model settings.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional GitHub OAuth App. Route the callback through the frontend API proxy
# so the refresh cookie is stored on the frontend origin.
GITHUB_OAUTH_CLIENT_ID=replace_with_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=replace_with_github_oauth_client_secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/api/v1/auth/github/callback

# GitHub App used for repository governance. Set its Setup URL to this callback;
# it supports both the legacy Governance install and team-scoped installations.
# http://localhost:5000/api/v1/github/install/callback
GITHUB_APP_ID=replace_with_github_app_id
GITHUB_APP_PRIVATE_KEY_PATH=./your-github-app-private-key.pem
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_WEBHOOK_SECRET=replace_with_your_github_webhook_secret

# Password reset email delivery through Resend.
RESEND_API_KEY=replace_with_resend_api_key
PASSWORD_RESET_FROM=HAKI <no-reply@example.com>
