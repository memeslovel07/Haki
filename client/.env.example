# Create an API key in Google AI Studio. Keep the real key in .env, never in VITE_*.
GEMINI_API_KEY=replace_with_your_gemini_api_key
# Optional; defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash

# Optional GitHub OAuth App settings for "Continue with GitHub".
# Set the OAuth App callback URL to the same value below.
GITHUB_CLIENT_ID=replace_with_your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=replace_with_your_github_oauth_app_client_secret
GITHUB_REDIRECT_URI=http://localhost:5173/api/auth/github/callback
