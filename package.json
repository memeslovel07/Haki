{
  "name": "haki",
  "version": "0.1.0",
  "description": "HAKI version control and code governance workspace",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace @haki/server",
    "build": "npm run build --workspace client && npm run build --workspace @haki/server",
    "lint": "npm run lint --workspace client",
    "test": "npm run test --workspace @haki/server"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "cli",
    "shared/contracts",
    "shared/schemas"
  ],
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
